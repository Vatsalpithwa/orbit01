# Orbit Mentor AI - Environment Variables
# Copy to .env.local and fill in your keys

# Supabase Configuration (Optional - app automatically falls back to secure Local Demo mode if empty)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# AI API Key (Optional - app includes built-in intelligent fallback mentor AI engine if empty)
GEMINI_API_KEY=your-google-gemini-api-key

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
